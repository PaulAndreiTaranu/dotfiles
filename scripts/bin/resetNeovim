#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../utils/utils.sh" || {
	echo "XXX FAILED TO LOAD UTILS.SH"
	exit 1
}

function reset_neovim() {
	print_green "### RESETTING NEOVIM"

	ensure_root

	# 1. Wipe state, cache, and plugins (keep config for re-stow)
	run_as_user "rm -rf $HOME/.local/share/nvim $HOME/.local/state/nvim $HOME/.cache/nvim"

	# 2. Re-stow config
	run_as_user "cd $DOTFILES_DIR/configs && stow --restow --no-folding --target=$HOME nvim"

	# 3. Ensure vi → nvim alias
	if command -v snap &>/dev/null && snap list nvim &>/dev/null; then
		snap alias nvim vi
	elif command -v nvim &>/dev/null; then
		run_as_user "ln -sf $(which nvim) $HOME/.local/bin/vi"
	fi

	print_green "### NEOVIM RESET COMPLETE"

}

if [ "${BASH_SOURCE[0]}" -ef "$0" ]; then
	reset_neovim
fi
